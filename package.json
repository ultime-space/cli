{
  "name": "@ultime/cli",
  "version": "0.1.3",
  "description": "Ultime · cli：通用命令行设施（参数 / 命令注册 / 上下文 / 退出码），零领域依赖",
  "keywords": [
    "argument-parser",
    "cli",
    "command-line",
    "command-registry",
    "exit-code",
    "typescript"
  ],
  "homepage": "https://github.com/ultime-space/cli#readme",
  "bugs": {
    "url": "https://github.com/ultime-space/cli/issues"
  },
  "license": "MIT",
  "author": "Ultime contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultime-space/cli.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "llms.txt",
    "SKILLS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build",
    "check": "vp check",
    "test": "vp test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-plus": "1.5.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0"
}
