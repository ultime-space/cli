{
  "name": "@ultime/cli",
  "version": "0.2.0",
  "description": "Ultime · cli：通用命令行设施（参数 / 命令注册 / 上下文 / 退出码），零领域依赖",
  "keywords": [
    "argument-parser",
    "cli",
    "command-line",
    "command-registry",
    "exit-code",
    "typescript"
  ],
  "homepage": "https://github.com/ultime-space/cli#readme",
  "bugs": {
    "url": "https://github.com/ultime-space/cli/issues"
  },
  "license": "MIT",
  "author": "Ultime contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultime-space/cli.git"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "SKILLS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check && ultime-checks run && pnpm cycles",
    "checks": "ultime-checks run",
    "cycles": "vp lint --import-plugin --deny=import/no-cycle src",
    "test": "vp test",
    "size": "size-limit --json",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.5",
    "@ultime/checks": "^0.3.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.6.0",
    "vite-plus": "1.5.1"
  },
  "size-limit": [
    {
      "name": "@ultime/cli",
      "path": "dist/index.js"
    }
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0"
}
